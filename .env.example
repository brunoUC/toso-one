# Copie para .env.local no desenvolvimento. Na Vercel, cadastre em
# Settings → Environment Variables.

# Senha de reserva. Serve para cadastrar o Face ID num aparelho novo.
# Use uma frase longa: com o Face ID ativo você quase nunca vai digitá-la.
TOSO_PASSWORD=

# Assina o cookie de sessão. Gere com: openssl rand -base64 48
TOSO_SESSION_SECRET=

# Segredo compartilhado entre o Next e o Convex. Precisa ser IGUAL aqui e
# no painel do Convex (Settings → Environment Variables). Gere com:
# openssl rand -base64 48
TOSO_SERVER_SECRET=

# Preenchido sozinho pelo `npx convex dev` (local) e pelo
# `npx convex deploy` (Vercel). Só preencha à mão se souber o que faz.
NEXT_PUBLIC_CONVEX_URL=

# Endereço público do Flight Tracker na Vercel, sem barra no fim. O toso one
# lê ${FLIGHTS_URL}/data.json para mostrar os voos.
# Ex.: https://flight-tracker-xxxx.vercel.app
FLIGHTS_URL=

# Mesmo valor de MONITOR_EDIT_PASSWORD no projeto do Flight Tracker na
# Vercel. O editor de rotas (Voos → Editar rotas) chama a API de lá com ela,
# sempre do servidor: o navegador nunca vê esta senha.
FLIGHTS_EDIT_PASSWORD=

# Token da tarefa agendada do Claude Code que escreve a análise semanal da
# XP (/api/agente/semana). O mesmo valor vai nas variáveis do ambiente do
# Claude Code. Gere com: openssl rand -base64 48
TOSO_AGENT_TOKEN=

# Agenda do Google no feed da página inicial: o "endereço secreto no formato
# iCal" de cada agenda, uma por linha (ou separadas por vírgula), com nome
# opcional antes de "|". Ex.: Pessoal|https://calendar.google.com/calendar/ical/.../basic.ics
GCAL_ICS=

# Protege /api/semana/manha (resumo da manhã por push). A Vercel manda sozinha
# no cabeçalho dos crons. Gere com: openssl rand -base64 32
CRON_SECRET=

# Lugar da previsão do tempo (padrão: São Paulo).
TOSO_PLACE=
TOSO_LAT=
TOSO_LON=

# Estante: busca de filmes e séries em português (themoviedb.org, grátis).
# Sem ela, a busca usa as sugestões do IMDb (títulos em inglês).
TMDB_API_KEY=

# Estante: cota própria no Google Books (opcional).
GOOGLE_BOOKS_KEY=
